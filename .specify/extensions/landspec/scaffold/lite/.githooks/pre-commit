#!/usr/bin/env bash
# landspec: managed file. /landspec:level re-creates it while this line stays; delete the line to keep your own edits.
# landspec: refuse commits that carry secrets (.env files, keys, tokens). Fast, local.
# Enabled per clone with: git config core.hooksPath .githooks   (/landspec:init does it)
s=.specify/extensions/landspec/scripts/secrets.sh
[ -f "$s" ] || { echo "landspec: $s missing, so nothing was checked; run /landspec:init to restore it, or git config --unset core.hooksPath to drop these hooks" >&2; exit 1; }
exec bash "$s" staged
